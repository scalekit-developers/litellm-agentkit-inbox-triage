# Scalekit project credentials — create a project at https://app.scalekit.com
SCALEKIT_ENV_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=

# Connection names — must match the exact names in Scalekit dashboard → AgentKit → Connections
# (copy the Connection name from the dashboard, it may differ from the provider slug)
GMAIL_CONNECTION_NAME=gmail
GITHUB_CONNECTION_NAME=github
SLACK_CONNECTION_NAME=slack

# Scalekit-hosted LiteLLM gateway — get an API key from the Scalekit dashboard
LITELLM_BASE_URL=https://llm.scalekit.cloud
LITELLM_API_KEY=

# How often to poll Gmail for new threads (milliseconds)
POLL_INTERVAL_MS=5000

# Port for the local approval dashboard
PORT=3000

# Directory for the SQLite database
DATA_DIR=./data
